# Copy to .env for local runs. On Dokploy, set the same names in the app's environment settings.
# Never commit .env.

TELEGRAM_BOT_TOKEN=123456:replace-me
# Random string, e.g. `openssl rand -hex 32`. Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=replace-me

# Public HTTPS origin Telegram can reach, e.g. https://claudia.example.com
PUBLIC_BASE_URL=https://claudia.example.com

# Optional. Enables voice in (Whisper) and voice replies (TTS).
OPENAI_API_KEY=

# Full contents of config/bot.toml. Needed on Dokploy, where the file is not in git.
# Locally you can leave it empty and the bot reads config/bot.toml from disk.
BOT_CONFIG_TOML=

# Local only. The Docker image sets these itself.
# DATA_DIR=data
# CONFIG_PATH=config/bot.toml
