# Copy to .env for local runs. On Dokploy, set the same names in the app's environment settings.
# Never commit .env.

TELEGRAM_BOT_TOKEN=123456:replace-me
# Random string, e.g. `openssl rand -hex 32`. Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=replace-me

# Public HTTPS origin Telegram can reach, e.g. https://claudia.example.com
PUBLIC_BASE_URL=https://claudia.example.com

# Optional. OpenAI enables voice in (Whisper). Gemini enables voice replies (TTS).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Full contents of config/bot.toml. Used on the first boot to create the editable copy at
# /data/bot.toml inside the data volume. Later boots read that copy and ignore this value.
BOT_CONFIG_TOML=
# Set to true for one deploy to overwrite the editable copy from BOT_CONFIG_TOML, then unset it.
BOT_CONFIG_RESEED=false

# Local only. The Docker image sets these itself.
# DATA_DIR=data
# CONFIG_PATH=config/bot.toml
